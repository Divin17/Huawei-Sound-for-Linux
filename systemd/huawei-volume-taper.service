[Unit]
Description=Windows volume curve for the MateBook speakers
After=pipewire.service wireplumber.service
PartOf=graphical-session.target

[Service]
ExecStart=%h/.local/bin/huawei-volume-taper
Environment=HUAWEI_VOLUME_CURVE=%h/.local/share/huawei-speakers/windows_volume_curve.csv
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
